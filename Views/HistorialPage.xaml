<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="NotasApp.Views.HistorialPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NotasApp.Models"
             xmlns:viewModels="clr-namespace:NotasApp.ViewModels"
             x:DataType="viewModels:HistorialViewModel"
             Title="Historial"
              BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
    <Grid RowDefinitions="Auto,*" Padding="20,16,20,20" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label Text="Historial" FontSize="30" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}" />
            <Label Text="Consulta los cambios realizados en tus notas" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Historial}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="◷" FontSize="42" HorizontalTextAlignment="Center" TextColor="#0F766E" />
                    <Label Text="Sin actividad todavía" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}" HorizontalTextAlignment="Center" />
                    <Label Text="Tus acciones aparecerán aquí" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Historial">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,14">
                        <VerticalStackLayout Grid.Column="0" Spacing="0" HorizontalOptions="Center">
                            <Border WidthRequest="34" HeightRequest="34" BackgroundColor="#E0E7FF" StrokeThickness="0" Padding="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                                <Label Text="•" FontSize="25" TextColor="#4F46E5" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <BoxView WidthRequest="2" HeightRequest="42" BackgroundColor="#CBD5E1" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Padding="14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
                                <Label Text="{Binding Accion}" FontAttributes="Bold" FontSize="16" TextColor="#0F766E" />
                                <Label Grid.Column="1" Text="{Binding Fecha, StringFormat='{}{0:dd MMM, HH:mm}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DetalleNota}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
